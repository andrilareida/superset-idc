# -----------------------------------------------------------------------
# Example .env-local file for running multiple Superset instances
# Copy this file to .env-local and customize for your setup
# -----------------------------------------------------------------------

# Unique project name prevents container/volume conflicts between clones
# Each clone should have a different name (e.g., superset-pr123, superset-feature-x)
COMPOSE_PROJECT_NAME=superset-dev2

# Port offsets for running multiple instances simultaneously
# Instance 1 (default): 80, 8088, 9000, 8080, 8081, 5432, 6379
# Instance 2 example:   81, 8089, 9001, 8082, 8083, 5433, 6380
NGINX_PORT=81
SUPERSET_PORT=8089
NODE_PORT=9001
WEBSOCKET_PORT=8082
CYPRESS_PORT=8083
DATABASE_PORT=5433
REDIS_PORT=6380

# For verbose logging during development:
# SUPERSET_LOG_LEVEL=debug

# -----------------------------------------------------------------------
# Athena JDBC + IDC (Identity Center) Authentication
# Required for per-user governed access to Athena via Trusted Identity Propagation.
# See the connection mutator module at docker/pythonpath_dev/athena_connection_mutator.py
# -----------------------------------------------------------------------

# ARN of the Identity Center application created for Superset.
# Used in the sso-oidc:CreateTokenWithIAM call to exchange the Cognito token.
# Find this in the AWS IAM Identity Center console under "Applications".
IDC_APPLICATION_ARN=arn:aws:sso::123456789012:application/ssoins-abc123/apl-xyz789

# IAM role assumed with the user's identity context via sts:AssumeRole.
# This role must have Lake Formation, Athena, S3, and Glue permissions,
# and its trust policy must allow ProvidedContexts from the service role.
ATHENA_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/your-athena-execution-role

# S3 path where Athena stores query results.
# Must be accessible by the execution role.
ATHENA_S3_STAGING_DIR=s3://your-athena-results-bucket/athena-results/

# AWS region for Athena and Identity Center endpoints.
AWS_REGION=us-east-1

# (Optional) IAM role that Superset assumes before calling IDC and STS APIs.
# When set, the mutator calls sts:AssumeRole to obtain service role credentials.
# When not set, the default AWS credential chain is used (instance profile, env vars, etc.).
# SUPERSET_SERVICE_ROLE_ARN=arn:aws:iam::123456789012:role/your-superset-service-role

# Cognito app client ID and secret, used for token operations.
# Find these in the Amazon Cognito console under "App clients".
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret

# Java CLASSPATH for the Athena JDBC driver (used by PyAthenaJDBC via JPype).
# Points to the JAR file volume-mounted from docker/jdbc-drivers/.
CLASSPATH=/app/jdbc-drivers/AthenaJDBC43.jar
